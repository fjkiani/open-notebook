# Multi-stage: copy surreal binary (glibc) into Debian slim for shell + PORT substitution
# IMPORTANT: open-notebook requires SurrealDB v2 syntax (FLEXIBLE TYPE, not TYPE FLEXIBLE)
FROM surrealdb/surrealdb:v2 AS surreal-bin

FROM debian:bookworm-slim
# Install CA certificates (required by SurrealDB for TLS)
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

# The surreal binary lives at /surreal in the scratch image
COPY --from=surreal-bin /surreal /usr/local/bin/surreal
RUN chmod +x /usr/local/bin/surreal

# Railway injects PORT env var; SurrealDB needs it via --bind
# /data is the Railway volume mount point (RocksDB persistence)
ENV PORT=8000
EXPOSE 8000

# Shell reads $PORT so Railway healthcheck works on the correct port
# file:/data/notebook.db = RocksDB on the mounted volume (survives restarts)
CMD ["sh", "-c", "/usr/local/bin/surreal start --log info --user root --pass root --bind 0.0.0.0:${PORT} file:/data/notebook.db"]
