# Multi-stage: copy surreal binary (glibc) into Debian slim for shell + PORT substitution
FROM surrealdb/surrealdb:latest AS surreal-bin

FROM debian:bookworm-slim
# The surreal binary lives at /surreal in the scratch image
COPY --from=surreal-bin /surreal /usr/local/bin/surreal
RUN chmod +x /usr/local/bin/surreal

# Railway injects PORT env var; SurrealDB needs it via --bind
ENV PORT=8000
EXPOSE 8000

# Shell reads $PORT so Railway healthcheck works on the correct port
CMD ["sh", "-c", "/usr/local/bin/surreal start --log info --user root --pass root --bind 0.0.0.0:${PORT} memory"]
